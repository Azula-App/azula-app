<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode 15.3+ name for the old "app-store". The workflow injects :teamID from
	     the APPLE_TEAM_ID secret with PlistBuddy, since a plist can't expand $(VARS). -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Export the .ipa rather than letting xcodebuild push it straight to App Store
	     Connect, so the workflow can also attach it as an artifact and run
	     `altool --validate-app` against it before the real upload. -->
	<key>destination</key>
	<string>export</string>
	<!-- Versions come from set_version.sh via MARKETING_VERSION /
	     CURRENT_PROJECT_VERSION. Never let Xcode invent a build number. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
