# Kotlin Compiler
.kotlin/

# Gradle
.gradle/
build/
gradle.properties

# Local configuration
local.properties

# Release signing — never commit. CI writes keystore.properties from secrets;
# locally: ./kotlin tool generate-keystore --properties-file android-app/keystore.properties
keystore.properties
*.jks
*.keystore

# Xcode
xcuserdata/
*.xcarchive

# IntelliJ/Android Studio
.idea/
*.iml

# azula device registry — holds iroh tickets (bearer credentials). Force-add
# only if you intentionally want to share devices with your team.
.azula/

# OS specific
.DS_Store
