<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep the iroh node alive in the background (foreground service + its
         persistent notification), wake the CPU to process frames, and post
         incoming-message notifications. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application android:name="app.azula.AzulaApplication"
                 android:label="azula"
                 android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name="app.azula.MainActivity"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: https://azula.app/s/<token> and /connect/<token>.
                 autoVerify requires assetlinks.json at azula.app with the RELEASE
                 signing SHA-256 — fill it once the app is signed (docs/deeplinks.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="azula.app" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="azula.app" android:pathPrefix="/connect/" />
            </intent-filter>

            <!-- Custom scheme fallback: azula://connect?code=<token> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="azula" />
            </intent-filter>
        </activity>

        <!-- Keeps the process (and the iroh node) alive while backgrounded. -->
        <service android:name="app.azula.IrohService"
                 android:exported="false"
                 android:foregroundServiceType="dataSync" />
    </application>
</manifest>
