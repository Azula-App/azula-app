<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep the iroh node alive in the background (foreground service + its
         persistent notification), wake the CPU to process frames, and post
         incoming-message notifications. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- On-phone compute host (compute-android-app-host). The two AVF permissions are
         signature|development: not grantable at runtime; the user grants them once
         over wireless debugging (pm grant). Declaring them is harmless for everyone
         who never hosts. -->
    <uses-permission android:name="android.permission.MANAGE_VIRTUAL_MACHINE" />
    <uses-permission android:name="android.permission.USE_CUSTOM_VIRTUAL_MACHINE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- selfgrant-real (see its README.manifest): finds Wireless debugging's pairing
         service over mDNS, which needs these two. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Lets the Developer-options-on check resolve Settings' screen (package visibility). -->
    <queries>
        <intent><action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" /></intent>
    </queries>
    <!-- Auto-saving received media to the public gallery/Downloads on API 26–28
         (pre-scoped-storage) writes to public external dirs + a media scan. On
         API ≥29 the MediaExporter uses scoped-storage MediaStore inserts, which
         need no permission — hence maxSdkVersion="28". -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
                     android:maxSdkVersion="28" />
    <application android:name="app.azula.AzulaApplication"
                 android:label="Azula"
                 android:icon="@mipmap/ic_launcher"
                 android:roundIcon="@mipmap/ic_launcher_round"
                 android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name="app.azula.MainActivity"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: https://azula.app/s/<token>, /connect/<token> (legacy),
                 /i/<payload> (invites), and /l/<payload> (device-link codes,
                 multi-device-identity task 6.6). autoVerify requires assetlinks.json at
                 azula.app with the RELEASE signing SHA-256 — fill it once the app
                 is signed (azula-docs/openspec/specs/deeplinks/design.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="azula.app" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="azula.app" android:pathPrefix="/connect/" />
                <data android:scheme="https" android:host="azula.app" android:pathPrefix="/i/" />
                <data android:scheme="https" android:host="azula.app" android:pathPrefix="/l/" />
            </intent-filter>

            <!-- Custom scheme fallback: azula://connect?code=<token> (legacy),
                 azula://i?c=<payload> (invites), and azula://l?c=<payload>
                 (device-link codes, multi-device-identity task 6.6). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="azula" />
            </intent-filter>

            <!-- OS "Share into Azula": lets Azula appear in the system share sheet
                 for images/video/audio/files (EXTRA_STREAM) and plain text
                 (EXTRA_TEXT) from any other app; see MainActivity.handleShareIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Keeps the process (and the iroh node) alive while backgrounded. -->
        <service android:name="app.azula.IrohService"
                 android:exported="false"
                 android:foregroundServiceType="dataSync" />

        <!-- Hosts a user-started Linux VM (AVF), in its own process so a UI crash
             doesn't take the VM down. Not exported: only this app starts or binds it. -->
        <service android:name="dev.azula.vmhost.HostService"
                 android:process=":vmhost"
                 android:exported="false"
                 android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="Hosts a user-started Linux virtual machine that runs commands sent by the user's own remote coding sessions; runs only while the user keeps hosting on, with a persistent notification and a Stop action." />
        </service>

        <!-- The one-time grant of the two VM permissions: pairs with Wireless debugging,
             then runs pm grant. Runs in the UI process, only until the grant finishes. -->
        <service android:name="dev.azula.selfgrant.SelfGrantService"
                 android:exported="false"
                 android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="One-time, user-started setup that grants this app its own virtual machine permissions through Wireless debugging pairing; runs only until the grant finishes." />
        </service>
        <receiver android:name="dev.azula.selfgrant.PairingReplyReceiver" android:exported="false" />
    </application>
</manifest>
