<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Azula</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both come from MARKETING_VERSION / CURRENT_PROJECT_VERSION in the Xcode
	     project, which .github/scripts/set_version.sh stamps on every release. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Auto-save received images/video into the Photos library (add-only). -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Azula saves media you receive to your photo library so you can view and share it.</string>
	<!-- Received audio/files auto-save into Documents/Azula/; these two keys make
	     that folder visible and editable in the Files app. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Custom scheme fallback: azula://connect?code=<token>. Universal links
	     (https://azula.app/s/<token>) use the Associated Domains entitlement
	     (azula.entitlements) + the AASA file served by site/. See docs/deeplinks.md. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.azula.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>azula</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
